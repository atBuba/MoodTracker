# PostgreSQL
POSTGRES_USER=moodtracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=moodtracker
DATABASE_URL=postgresql+asyncpg://moodtracker:changeme@postgres:5432/moodtracker

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=moodtracker
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://moodtracker:changeme@rabbitmq:5672/

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme
MINIO_URL=http://minio:9000

# JWT
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# Service Communication
INTERNAL_API_KEY=your-internal-api-key

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# External
ANTHROPIC_API_KEY=your-anthropic-api-key
NANOBANANA_API_KEY=your-nanobanana-api-key